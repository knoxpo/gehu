{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"projects": {
		"angular-basic": {
			"projectType": "application",
			"root": "",
			"sourceRoot": "src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular/build:application",
					"options": {
						"outputPath": "dist",
						"index": "src/index.html",
						"browser": "src/main.ts",
						"tsConfig": "tsconfig.json",
						"polyfills": ["zone.js"],
						"assets": [],
						"styles": []
					}
				},
				"serve": {
					"builder": "@angular/build:dev-server",
					"options": { "buildTarget": "angular-basic:build" }
				}
			}
		}
	}
}
