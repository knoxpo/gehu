{
  "name": "@gehu-js/core",
  "version": "0.1.0",
  "description": "Platform-agnostic signal-powered store engine for Gehu.",
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "homepage": "https://github.com/knoxpo/gehu#readme",
  "bugs": {
    "url": "https://github.com/knoxpo/gehu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knoxpo/gehu.git",
    "directory": "packages/core"
  },
  "keywords": [
    "gehu",
    "signals",
    "state-management",
    "store",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:esm": "tsc -p tsconfig.json --outDir dist/esm",
    "build:cjs": "tsc -p tsconfig.json --outDir dist/cjs --module commonjs --moduleResolution node --verbatimModuleSyntax false --declaration false --declarationMap false && bun -e \"await Bun.write('dist/cjs/package.json', '{\\n  \\\"type\\\": \\\"commonjs\\\"\\n}\\n')\"",
    "build:types": "tsc -p tsconfig.json --outDir dist/types --emitDeclarationOnly true",
    "build": "bun run clean && bun run build:esm && bun run build:cjs && bun run build:types",
    "prepack": "node ../../tools/release/prepare-package.mjs",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.types-test.json --noEmit"
  }
}
